#!/usr/bin/env python3
"""Stand-in for llama-bench: emits real-format JSON / JSONL (fields as in llama.cpp b907) for the requested sweep.
FAKE_BACKEND picks the backend string; FAKE_FAIL=1 fails like a device-lost abort (message names a model path);
FAKE_SLOW_DEPTH=N prints the pp result and then stalls (like a very slow tg) for depths >= N."""
import json, os, sys, time
a = sys.argv[1:]
if "--list-devices" in a:  # FAKE_DEVICES="NAME=DESC=MiB;..." (default: one B70)
    print("Available devices:")
    for d in os.environ.get("FAKE_DEVICES", "SYCL0=Intel(R) Arc(TM) Pro B70 Graphics=31000").split(";"):
        name, desc, mib = d.split("=")
        print(f"  {name}: {desc} ({mib} MiB, {int(mib) - 100} MiB free)")
    sys.exit(0)
def opt(k, d):
    return a[a.index(k) + 1] if k in a else d
if os.environ.get("FAKE_FAIL") == "1":
    print(f"ggml_sycl: UR_RESULT_ERROR_DEVICE_LOST while loading {os.path.expanduser('~')}/models/x.gguf", file=sys.stderr); sys.exit(134)
backend = os.environ.get("FAKE_BACKEND", "SYCL")
rows = []
for fa in opt("-fa", "1").split(","):
    for d in opt("-d", "0").split(","):
        for p, n in ((int(opt("-p", 512)), 0), (0, int(opt("-n", 128)))):
            ts = (1000.0 if p else 50.0) / (1 + int(d) / 16384) * (1.1 if backend == "SYCL" else 1.0)
            rows.append({"build_commit": "097cf33d9", "build_number": 7001, "cpu_info": "Fake CPU",
                         "gpu_info": "Intel(R) Arc(TM) Pro B70 Graphics", "backends": backend,
                         "model_filename": opt("-m", "?"), "model_type": "fake 7B Q4_0", "model_size": 1,
                         "model_n_params": 1, "n_threads": 8, "type_k": "f16", "type_v": "f16",
                         "n_gpu_layers": 99, "split_mode": opt("-sm", "layer"), "devices": "auto", "flash_attn": int(fa), "n_prompt": p, "n_gen": n, "n_depth": int(d),
                         "avg_ns": 1, "stddev_ns": 1, "avg_ts": ts, "stddev_ts": ts / 100,
                         "samples_ns": [1], "samples_ts": [ts]})
if opt("-o", "md") == "jsonl":
    slow = int(os.environ.get("FAKE_SLOW_DEPTH", "0") or 0)
    for r in rows:
        if slow and r["n_depth"] >= slow and r["n_gen"]:
            time.sleep(60)
        print(json.dumps(r), flush=True)
else:
    print(json.dumps(rows, indent=2))
